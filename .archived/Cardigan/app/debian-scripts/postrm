#!/bin/sh
# Recompiles the GSettings schema cache again after this package is
# removed, mirroring postinst's own reasoning -- otherwise barkeeps's
# own schema would keep lingering in the compiled cache even after the
# .xml file that produced it is gone.
set -e

if [ "$1" = "remove" ] && command -v glib-compile-schemas >/dev/null 2>&1; then
    glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1 || true
fi

exit 0
